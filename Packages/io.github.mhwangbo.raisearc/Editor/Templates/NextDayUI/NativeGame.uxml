<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="NativeGame.uss" />
    <ui:VisualElement name="room" class="month-room">
        <ui:Image name="background" class="month-background" scale-mode="ScaleAndCrop" picking-mode="Ignore" />
        <ui:VisualElement class="month-hud">
            <ui:Label name="character-name" class="brand" />
            <ui:Label name="money-label" text="MONEY" class="caption" /><ui:Label name="money" class="value" />
            <ui:Label name="wisdom-label" text="WISDOM" class="caption" /><ui:Label name="wisdom" class="value" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="save" text="Save" class="quiet" /><ui:Button name="load" text="Load" class="quiet" /><ui:Button name="restart" text="Restart" class="quiet" />
        </ui:VisualElement>
        <ui:Label name="status" class="status" />
        <ui:VisualElement class="month-content">
            <ui:Image name="character" class="character" picking-mode="Ignore" />
            <ui:VisualElement class="intro-card">
                <ui:Label name="room-kicker" class="eyebrow" />
                <ui:Label name="room-title" class="intro-title" />
                <ui:Label name="room-description" class="intro-copy" />
                <ui:VisualElement class="date-row"><ui:Label name="date-position-label" class="date-caption" /><ui:Label name="date-position" class="date-value" /></ui:VisualElement>
                <ui:VisualElement class="date-row"><ui:Label name="target-date-label" class="date-caption" /><ui:Label name="target-date" class="date-value" /></ui:VisualElement>
                <ui:Button name="open-plan" text="Open plan" class="primary" />
                <ui:Button name="run-plan" text="Start planned day" class="primary confirmed-action" />
                <ui:Button name="run-next" text="One activity" class="quiet confirmed-action" />
            </ui:VisualElement>
            <ui:VisualElement name="plan-panel" class="overlay raisearc-hidden">
                <ui:VisualElement class="plan-sheet">
                    <ui:VisualElement class="header"><ui:Label name="plan-title" class="title" /><ui:Label name="plan-target-date" class="title-date" /><ui:Label name="plan-status" class="plan-status" /><ui:VisualElement class="spacer" /><ui:Button name="close-plan" text="Close" class="quiet" /></ui:VisualElement>
                    <ui:Label name="plan-instruction" class="instruction" />
                    <ui:VisualElement class="plan-body">
                        <ui:VisualElement class="activity-column">
                            <ui:Label name="activities-title" class="section-label" />
                            <ui:ScrollView class="activity-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"><ui:VisualElement name="activities" class="activity-list" /></ui:ScrollView>
                        </ui:VisualElement>
                        <ui:VisualElement class="calendar-column">
                            <ui:ScrollView class="calendar-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"><ui:VisualElement name="slots" class="slot-list" /></ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="footer"><ui:Button name="clear-slot" text="Clear" class="draft-action quiet" /><ui:Button name="new-plan" text="Plan following day" class="quiet" /><ui:VisualElement class="spacer" /><ui:Button name="confirm" text="Confirm" class="draft-action primary" /><ui:Button name="plan-run-plan" text="Start planned day" class="confirmed-action primary" /></ui:VisualElement>
                    <ui:Label name="confirm-reason" class="reason" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialogue-panel" class="overlay dialogue-overlay raisearc-hidden">
                <ui:VisualElement class="dialogue-sheet"><ui:Label name="speaker" class="speaker" /><ui:ScrollView class="dialogue-scroll"><ui:Label name="dialogue" class="dialogue-text" /><ui:VisualElement name="choices" class="choice-list" /></ui:ScrollView><ui:Button name="continue" text="Continue" class="primary continue-action" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ending-panel" class="ending raisearc-hidden"><ui:Label name="ending-title" class="eyebrow" /><ui:Label name="ending" class="intro-title" /></ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
