.studio { background-color: #15151f; color: #e6e2ef; flex-grow: 1; }
.studio-header { height: 72px; flex-direction: row; align-items: center; padding-left: 24px; padding-right: 18px; border-bottom-width: 1px; border-bottom-color: #363344; }
.brand { font-size: 23px; -unity-font-style: bold; color: #edd9ac; }
.eyebrow { color: #a49bb9; font-size: 10px; letter-spacing: 2px; margin-bottom: 6px; }
.spacer { flex-grow: 1; }
.toolbar { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: center; padding: 10px 16px; background-color: #1d1c29; }
.studio-body { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.navigation { width: 196px; flex-shrink: 0; min-height: 0; background-color: #191822; padding: 10px 6px; border-right-width: 1px; border-right-color: #363344; }
.nav-button { height: 33px; flex-shrink: 0; margin-bottom: 5px; -unity-text-align: middle-left; padding-left: 14px; background-color: #191822; border-width: 0; color: #b7afc7; }
.nav-button.selected { background-color: #393149; color: #f3e5c8; border-left-width: 3px; border-left-color: #d4b981; }
.content-pane { flex-grow: 1; padding: 22px; }
.section-title { font-size: 23px; -unity-font-style: bold; margin-bottom: 6px; }
.subtitle { color: #a9a0ba; white-space: normal; margin-bottom: 20px; }
.split { flex-direction: row; flex-grow: 1; }
.catalog { width: 214px; margin-right: 18px; }
.detail { flex-grow: 1; background-color: #22202f; border-radius: 8px; padding: 18px; }
.card { background-color: #262331; border-width: 1px; border-color: #41394f; border-radius: 7px; padding: 15px; margin-bottom: 12px; }
.card-title { font-size: 16px; -unity-font-style: bold; margin-bottom: 9px; color: #efdfbd; }
.row { flex-direction: row; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
.row > * { margin-right: 8px; }
.metric { width: 170px; margin-right: 12px; padding: 18px; background-color: #282435; border-radius: 7px; }
.metric-value { font-size: 30px; color: #eddbb8; }
.metric-label { font-size: 11px; color: #b6abc8; }
.studio Button { background-color: #34303f; color: #eee7f4; border-color: #4b435a; border-width: 1px; border-radius: 4px; padding: 6px 11px; min-height: 28px; }
.studio Button:hover { background-color: #4b405c; }
.studio Button.primary { background-color: #d4b981; color: #24202c; border-color: #d4b981; -unity-font-style: bold; }
.studio Button:disabled { opacity: 0.4; }
.studio .unity-base-field { margin-bottom: 10px; }
.studio .unity-base-field__label { color: #c6bdd5; min-width: 150px; }
.studio .unity-base-field__input { background-color: #171620; color: #f0eaf6; border-color: #4c435c; border-width: 1px; min-height: 24px; }
.studio .unity-text-field__input { white-space: normal; }
.status { min-height: 28px; padding: 7px 18px; color: #b8aecb; border-top-width: 1px; border-top-color: #363344; white-space: normal; }
.notice { color: #e7bf83; white-space: normal; margin-top: 12px; margin-bottom: 12px; }
.report { white-space: normal; color: #d5cde1; }
.entry { height: 44px; padding-left: 10px; justify-content: center; border-bottom-width: 1px; border-bottom-color: #393142; }
.entry-name { color: #f0e7d5; font-size: 13px; }
.entry-id { color: #a299b5; font-size: 10px; }
.preview { background-color: #211e2c; padding: 24px; border-radius: 10px; max-width: 820px; flex-grow: 1; }
.preview-heading { font-size: 32px; color: #f0dcb3; margin-bottom: 8px; }
.preview-text { font-size: 16px; white-space: normal; margin-top: 16px; margin-bottom: 18px; }
.drop-target { border-width: 2px; border-color: #9b82bc; padding: 18px; margin-top: 12px; background-color: #2c253a; border-radius: 6px; }
.code-input { min-height: 200px; flex-grow: 1; }
